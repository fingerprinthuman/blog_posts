---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, tags } = entry.data;

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${title} — AI Experiments`} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
        {
          updatedDate && (
            <>
              {' · updated '}
              <time datetime={updatedDate.toISOString()}>{fmt.format(updatedDate)}</time>
            </>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </p>
        )
      }
    </header>
    <Content />
  </article>
</BaseLayout>

<style>
  h1 {
    font-size: 1.75rem;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .meta {
    margin: 0;
    color: #9aa2ad;
    font-size: 0.9rem;
  }

  .tags {
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    background: #1c2230;
    color: #9fb6d8;
    border-radius: 999px;
    padding: 0.1rem 0.65rem;
    font-size: 0.78rem;
  }

  article :global(h2) {
    font-size: 1.3rem;
    margin-top: 2rem;
  }

  article :global(img) {
    max-width: 100%;
    height: auto;
  }

  article :global(audio) {
    width: 100%;
    margin: 0.5rem 0;
  }
</style>
