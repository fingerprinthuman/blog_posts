---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>&copy; {year} human fingerprint. Built with <a href="https://astro.build">Astro</a>.</p>
</footer>

<style>
  .site-footer {
    max-width: 46rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 2.5rem;
    border-top: 1px solid #262b33;
    color: #9aa2ad;
    font-size: 0.85rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: #7fb4ff;
  }
</style>
