---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <a class="brand" href={base}>AI Experiments</a>
  <nav>
    <a href={base}>Home</a>
    <a href={`${base}blog/`}>Blog</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    max-width: 46rem;
    margin: 0 auto;
    padding: 1.25rem 1rem;
    border-bottom: 1px solid #262b33;
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: #e6e9ee;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1rem;
  }

  nav a {
    color: #9aa2ad;
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: #e6e9ee;
  }
</style>
